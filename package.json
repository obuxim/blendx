{
  "name": "blendx-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun test",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.portable.json && tsc --noEmit -p packages/core/test/register/tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@blendx/cli": "workspace:*",
    "@blendx/conformance": "workspace:*",
    "@blendx/core": "workspace:*",
    "@blendx/dbml": "workspace:*",
    "@blendx/hono": "workspace:*",
    "blendx": "workspace:*",
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
