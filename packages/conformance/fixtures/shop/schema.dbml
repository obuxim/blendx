// The conformance suite's shop fixture: every derivation rule needs a column to act on.

Enum order_status {
  pending
  paid
  refunded
}

Table users {
  id int [pk, increment]
  email varchar(255) [not null, unique]
  password varchar(255) [not null]
  display_name varchar(80)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table projects {
  id int [pk, increment]
  name varchar(80) [not null]
}

Table invites {
  token varchar(80) [pk]
  project_id int [not null, ref: > projects.id]
  accepted_by int [ref: > users.id]
  accepted_at timestamptz
}

Table uploads {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  filename varchar(255) [not null]
  content_type varchar(120) [not null]
  byte_length int [not null]
}

Table project_members {
  project_id int [not null, ref: > projects.id]
  user_id int [not null, ref: > users.id]

  indexes {
    (project_id, user_id) [pk]
  }
}

Table sections {
  id int [pk, increment]
  project_id int [not null, ref: > projects.id]
  name varchar(80) [not null]
}

Table tasks {
  id int [pk, increment]
  project_id int [not null, ref: > projects.id]
  section_id int [not null, ref: > sections.id]
  assignee_id int [not null, ref: > users.id]
  title varchar(120) [not null]
}

// The P17.22 relation set: a task may have every user who belongs to its project.
Table task_assignees {
  task_id int [not null, ref: > tasks.id]
  user_id int [not null, ref: > users.id]

  indexes {
    (task_id, user_id) [pk]
  }
}

Table orders {
  id bigint [pk, increment]
  user_id int [not null, ref: > users.id]
  status order_status [not null, default: 'pending']
  total numeric(10,2) [not null]
  quantity int [not null, default: 1]
  tags text[]
  meta jsonb
  public_id uuid [not null, unique, default: `gen_random_uuid()`]
  placed_on date
  weight double
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  indexes {
    (user_id, status) [name: 'orders_user_status_idx']
    created_at
  }
}

Table order_notes {
  id int [pk, increment]
  order_id bigint [not null]
  author_id int [ref: > users.id]
  body text [not null]
  created_at timestamp [not null, default: `now()`]
}

Ref: order_notes.order_id > orders.id [delete: cascade]

// A composite primary key (D33): a line of an order, addressed by its order and its number.
Table order_items {
  order_id bigint [not null]
  line int [not null]
  sku varchar(32) [not null]
  quantity int [not null, default: 1]

  indexes {
    (order_id, line) [pk]
  }
}

Ref: order_items.order_id > orders.id [delete: cascade]
