{
  "format": 1,
  "fixture": "shop",
  "cases": [
    {
      "id": "COMPOSITE-KEY",
      "title": "a composite primary key is one path segment per column, in the key order, and its columns are input (D33)",
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/order_items/1/2",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 200,
            "body": { "order_id": 1, "line": 2, "sku": "B-2", "quantity": 1 }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/order_items/1/9",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 404,
            "headers": { "content-type": "application/problem+json" },
            "body": { "status": 404 }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/order_items/1/x",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 404,
            "headers": { "content-type": "application/problem+json" },
            "body": { "status": 404 }
          }
        },
        {
          "request": {
            "method": "PATCH",
            "path": "/order_items/1/2",
            "headers": { "x-user-id": "1" },
            "body": { "quantity": 3 }
          },
          "expect": {
            "status": 200,
            "body": { "order_id": 1, "line": 2, "sku": "B-2", "quantity": 3 }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/order_items/1/1",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 200,
            "body": { "order_id": 1, "line": 1, "quantity": 2 }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/order_items",
            "headers": { "x-user-id": "1" },
            "body": { "order_id": 1, "line": 3, "sku": "C-3" }
          },
          "expect": {
            "status": 201,
            "body": { "order_id": 1, "line": 3, "sku": "C-3", "quantity": 1 }
          }
        },
        {
          "request": {
            "method": "POST",
            "path": "/order_items",
            "headers": { "x-user-id": "1" },
            "body": { "order_id": 1, "line": 3, "sku": "D-4" }
          },
          "expect": {
            "status": 409,
            "headers": { "content-type": "application/problem+json" },
            "body": { "status": 409 }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/order_items?order_id=1",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 200,
            "body": {
              "data": [{ "line": 1 }, { "line": 2 }, { "line": 3 }],
              "meta": { "total": 3 }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/order_items?sort=-line",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 200,
            "body": { "data": [{ "line": 3 }, { "line": 2 }, { "line": 1 }] }
          }
        },
        {
          "request": {
            "method": "DELETE",
            "path": "/order_items/1/3",
            "headers": { "x-user-id": "1" }
          },
          "expect": { "status": 204, "body": "$absent" }
        },
        {
          "request": {
            "method": "GET",
            "path": "/order_items/1/3",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 404,
            "headers": { "content-type": "application/problem+json" },
            "body": { "status": 404 }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/order_items?order_id=1",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 200,
            "body": { "data": [{ "line": 1 }, { "line": 2 }], "meta": { "total": 2 } }
          }
        }
      ]
    },
    {
      "id": "INCLUDE-COMPOSITE",
      "title": "?include=items nests an order's lines, a composite-key table, in the order of its key (D33)",
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/orders/1?include=items",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 200,
            "body": {
              "id": 1,
              "items": [
                { "order_id": 1, "line": 1, "sku": "A-1", "quantity": 2 },
                { "order_id": 1, "line": 2, "sku": "B-2", "quantity": 1 }
              ]
            }
          }
        }
      ]
    }
  ]
}
