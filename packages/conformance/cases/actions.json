{
  "format": 1,
  "fixture": "shop",
  "cases": [
    {
      "id": "PURGE",
      "title": "purge deletes a row for good, soft-deleted or not, under its own policy (D29)",
      "steps": [
        {
          "request": {
            "method": "DELETE",
            "path": "/orders/1/purge",
            "headers": { "x-user-id": "2" }
          },
          "expect": {
            "status": 403,
            "headers": { "content-type": "application/problem+json" },
            "body": { "status": 403 }
          }
        },
        {
          "request": { "method": "DELETE", "path": "/orders/1", "headers": { "x-user-id": "1" } },
          "expect": { "status": 204, "body": "$absent" }
        },
        {
          "request": {
            "method": "GET",
            "path": "/orders?trashed=only",
            "headers": { "x-user-id": "1" }
          },
          "expect": { "status": 200, "body": { "meta": { "total": 1 } } }
        },
        {
          "request": {
            "method": "DELETE",
            "path": "/orders/1/purge",
            "headers": { "x-user-id": "1" }
          },
          "expect": { "status": 204, "body": "$absent" }
        },
        {
          "request": {
            "method": "POST",
            "path": "/orders/1/restore",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 404,
            "headers": { "content-type": "application/problem+json" },
            "body": { "status": 404 }
          }
        },
        {
          "request": {
            "method": "GET",
            "path": "/orders?trashed=with",
            "headers": { "x-user-id": "1" }
          },
          "expect": { "status": 200, "body": { "data": [], "meta": { "total": 0 } } }
        },
        {
          "request": {
            "method": "POST",
            "path": "/orders",
            "headers": { "x-user-id": "1" },
            "body": { "user_id": 1, "total": "4.00" }
          },
          "expect": { "status": 201, "body": { "deleted_at": null } },
          "capture": { "order": "/id" }
        },
        {
          "request": {
            "method": "DELETE",
            "path": "/orders/{order}/purge",
            "headers": { "x-user-id": "1" }
          },
          "expect": { "status": 204, "body": "$absent" }
        },
        {
          "request": {
            "method": "GET",
            "path": "/orders?trashed=with",
            "headers": { "x-user-id": "1" }
          },
          "expect": { "status": 200, "body": { "data": [], "meta": { "total": 0 } } }
        }
      ]
    },
    {
      "id": "INCLUDE-HAS-MANY",
      "title": "?include=notes nests each order's two newest notes, each as its show would reply, as an array that is [] where it would refuse (D31)",
      "steps": [
        {
          "request": {
            "method": "GET",
            "path": "/orders/1?include=notes,user",
            "headers": { "x-user-id": "1" }
          },
          "expect": {
            "status": 200,
            "body": {
              "id": 1,
              "user": { "id": 1 },
              "notes": [
                { "id": 3, "order_id": 1, "body": "third", "created_at": "$timestamp" },
                { "id": 2, "order_id": 1, "body": "second" }
              ]
            }
          }
        },
        {
          "request": { "method": "GET", "path": "/orders?include=notes" },
          "expect": { "status": 200, "body": { "data": [{ "id": 1, "notes": [] }] } }
        },
        {
          "request": {
            "method": "GET",
            "path": "/orders?include=notes",
            "headers": { "x-user-id": "2" }
          },
          "expect": {
            "status": 200,
            "body": { "data": [{ "id": 1, "notes": [{ "id": 3 }, { "id": 2 }] }] }
          }
        }
      ]
    }
  ]
}
