{
  "name": "blendx",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "blendx: the only package an app imports at runtime. The blendx command is @blendx/cli, a dev dependency.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./drizzle": "./src/drizzle.ts"
  },
  "dependencies": {
    "@blendx/core": "workspace:*",
    "@blendx/hono": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.7",
    "zod": "4.6.2"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "pg": "^8.23.0",
    "postgres": "^3.4.9"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "pg": "8.23.0"
  }
}
