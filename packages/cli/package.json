{
  "name": "@blendx/cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The blendx command (generate, review, migrate) and the review examples runner. Apps add it as a dev dependency.",
  "bin": {
    "blendx": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./examples": "./src/examples.ts"
  },
  "devDependencies": {
    "hono": "4.13.7"
  },
  "dependencies": {
    "@blendx/core": "workspace:*",
    "@blendx/dbml": "workspace:*",
    "@typescript/typescript6": "6.0.2",
    "blendx": "workspace:*",
    "drizzle-kit": "1.0.0-rc.4",
    "yaml": "2.9.1"
  }
}
